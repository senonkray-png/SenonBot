# Runtime
NODE_ENV=production

# Telegram bot/API service
BOT_TOKEN=123456:replace_me
DUMP_CHANNEL_ID=-1001234567890
BOT_POLLING_ENABLED=true
API_PORT=3001
CORS_ORIGIN=https://your-mini-app.example.com

# Telegram user-client worker (MTProto)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELEGRAM_PHONE_NUMBER=+380000000000
TELEGRAM_SESSION=replace_me_after_npm_run_auth

# Railway Postgres
DATABASE_URL=postgresql://postgres:password@host:5432/railway
DATABASE_SSL=false

# Railway Bucket / S3-compatible media storage
S3_BUCKET=your-railway-bucket-name
S3_ENDPOINT=https://your-railway-bucket-endpoint
S3_REGION=auto
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=true

# AI / LLM autoresponder (OpenRouter by default)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro
# Fallback: direct OpenAI (used only when OPENROUTER_API_KEY is empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram dialog folder names (userbot creates them automatically)
UNANSWERED_FOLDER=Без Ответа
AUTOREPLIED_FOLDER=Ав-Ответ

# Mini App build-time public config
VITE_API_BASE_URL=https://your-api.example.com
